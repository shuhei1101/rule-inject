{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Edit|Write|NotebookEdit|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "_description": "操作の対象に該当する未読のルールを案内し、必須の操作なら止める",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" rule_guide",
            "timeout": 1
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Read|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "_description": "Read か Bash で読んだルールの場所と、read_by に該当した MCP のツールの呼び出しのルールの場所を既読として記録し、既読の履歴へ残す",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" record_read",
            "timeout": 1
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "_description": "検索の結果に出たファイルに該当する未読のルールを、止めずに案内する",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" search_guide",
            "timeout": 1
          }
        ]
      }
    ],

    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "_description": "圧縮の前に、そのセッションの既読の記録を捨てる",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" discard_read",
            "timeout": 1
          }
        ]
      }
    ],

    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "_description": "圧縮の後に、削除できずに残った既読の記録と設定ファイルが読めない理由を通知する",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" work_rules",
            "timeout": 1
          },
          {
            "type": "command",
            "_description": "保持期間を過ぎた別のセッションの既読の記録を削除する",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" sweep_read",
            "timeout": 1
          },
          {
            "type": "command",
            "_description": "常駐の MCP サーバーが応答しなければ、systemd --user のユニットへ起動を依頼し、/mcp で再接続する案内を記載する",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/run.py\" start_server",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
